# The Arduino's port. On Windows it looks like COM3: find it in the Arduino IDE (Tools > Port) or Device Manager.
SERIAL_PORT=COM3
BAUD_RATE=9600
API_URL=http://localhost:4000
# This bin's key. The dev key from backend/schema.sql is below. Never commit the real one.
DEVICE_API_KEY=dev-bin-key-change-me
# how often to tell the backend the bin is alive (the dashboard shows Offline after 2 minutes of silence)
HEARTBEAT_SECONDS=30
