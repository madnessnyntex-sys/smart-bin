NODE_ENV=development
PORT=4000
# the website(s) allowed to call this API. Several can be listed, separated by commas
CORS_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=smart_bin
# hosted MySQL: set DB_SSL=true. Only add DB_SSL_CA if your provider gave you its own certificate
# DB_SSL=true
# DB_SSL_CA=
# max connections per copy of the API (default 10, or 3 on Vercel)
# DB_POOL_SIZE=3
# for scripts that call the refill endpoint without logging in. use something long and random
ADMIN_TOKEN=change-me
# signs dashboard login tokens. use 32+ random characters (required in production)
JWT_SECRET=change-me-to-a-long-random-string
# people need this code to create a dashboard account. leave empty to turn registration off
REGISTER_CODE=change-me
